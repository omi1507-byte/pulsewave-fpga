# ==============================================================================
# PulseWave-FPGA Physical Constraints (LPF for Lattice ECP5 LFE5U-25F-6BG256C)
# ==============================================================================

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

# Primary 25.0 MHz Oscillator Input
LOCATE COMP "clk_25m" SITE "P6";
IOBUF  PORT "clk_25m" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25m" 25.0 MHz;

# Status Diagnostic LEDs
LOCATE COMP "led_power"     SITE "B1";
LOCATE COMP "led_armed"     SITE "C2";
LOCATE COMP "led_triggered" SITE "C1";
LOCATE COMP "led_usb_act"   SITE "D2";
IOBUF  PORT "led_power"     IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF  PORT "led_armed"     IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF  PORT "led_triggered" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF  PORT "led_usb_act"   IO_TYPE=LVCMOS33 DRIVE=8;

# 16-Channel High-Speed Logic Analyzer Probe Inputs (Bank 0 & Bank 1)
LOCATE COMP "probe_pins[0]"  SITE "A2";
LOCATE COMP "probe_pins[1]"  SITE "A3";
LOCATE COMP "probe_pins[2]"  SITE "B3";
LOCATE COMP "probe_pins[3]"  SITE "B4";
LOCATE COMP "probe_pins[4]"  SITE "C4";
LOCATE COMP "probe_pins[5]"  SITE "D4";
LOCATE COMP "probe_pins[6]"  SITE "E4";
LOCATE COMP "probe_pins[7]"  SITE "F4";
LOCATE COMP "probe_pins[8]"  SITE "A9";
LOCATE COMP "probe_pins[9]"  SITE "B9";
LOCATE COMP "probe_pins[10]" SITE "A10";
LOCATE COMP "probe_pins[11]" SITE "B10";
LOCATE COMP "probe_pins[12]" SITE "A11";
LOCATE COMP "probe_pins[13]" SITE "B11";
LOCATE COMP "probe_pins[14]" SITE "C11";
LOCATE COMP "probe_pins[15]" SITE "D11";

IOBUF PORT "probe_pins[0]"  IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[1]"  IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[2]"  IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[3]"  IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[4]"  IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[5]"  IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[6]"  IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[7]"  IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[8]"  IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[9]"  IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[10]" IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[11]" IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[12]" IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[13]" IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[14]" IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;
IOBUF PORT "probe_pins[15]" IO_TYPE=LVCMOS33 PULLMODE=DOWN HYSTERESIS=SMALL;

# FTDI FT232HQ High-Speed 60MHz Synchronous FIFO Interface (Bank 6)
LOCATE COMP "ft_clk60"   SITE "M3";
LOCATE COMP "ft_rxf_n"   SITE "N3";
LOCATE COMP "ft_txe_n"   SITE "P3";
LOCATE COMP "ft_rd_n"    SITE "R3";
LOCATE COMP "ft_wr_n"    SITE "T3";
LOCATE COMP "ft_oe_n"    SITE "M4";
LOCATE COMP "ft_data[0]" SITE "R4";
LOCATE COMP "ft_data[1]" SITE "T4";
LOCATE COMP "ft_data[2]" SITE "R5";
LOCATE COMP "ft_data[3]" SITE "T5";
LOCATE COMP "ft_data[4]" SITE "R6";
LOCATE COMP "ft_data[5]" SITE "T6";
LOCATE COMP "ft_data[6]" SITE "R7";
LOCATE COMP "ft_data[7]" SITE "T7";

IOBUF PORT "ft_clk60"   IO_TYPE=LVCMOS33;
IOBUF PORT "ft_rxf_n"   IO_TYPE=LVCMOS33;
IOBUF PORT "ft_txe_n"   IO_TYPE=LVCMOS33;
IOBUF PORT "ft_rd_n"    IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "ft_wr_n"    IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "ft_oe_n"    IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
IOBUF PORT "ft_data[*]" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
FREQUENCY PORT "ft_clk60" 60.0 MHz;
